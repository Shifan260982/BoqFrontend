# Copy to .env (not committed) to change where the page finds the comparison API.

# Local development: where `npm start` / `npm run preview` pass /api calls (the AreconPy backend).
ARECON_API=http://127.0.0.1:8000

# Hosted build: the API's public address, baked in by `npm run build`. Leave empty when the page and the API
# share one address (one reverse proxy in front of both).
VITE_API_URL=
